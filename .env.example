# ============================================================
# THUNDR DAILY REWARDS AUTOMATION — CONFIGURATION
# ============================================================

# --- Option 1: Single Account Configuration ---
THUNDR_USERNAME=
THUNDR_PASSWORD=
THUNDR_USER_ID=
THUNDR_HASHED_TOKEN=

# --- Option 2: Multi-Account Configuration (JSON Array) ---
# Ideal for GitHub Actions Secret "THUNDR_ACCOUNTS_JSON"
# Format:
# [
#   {"username": "user1", "password": "pwd", "user_id": "...", "hashed_token": "..."},
#   {"username": "user2", "password": "pwd"}
# ]
THUNDR_ACCOUNTS_JSON=

# --- Telegram Notifications ---
# Create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notification mode:
# 'all'          - Send message for every run (claimed, cooldown, error)
# 'rewards_only' - Only send message when a reward was successfully claimed
# 'errors_only'  - Only send message when an error occurred
# 'summary'      - Send one single consolidated message for all accounts
TELEGRAM_MODE=all

# --- Localization & Scheduling ---
# Preferred timezone for timestamp display (Europe/Berlin matches your local time)
APP_TIMEZONE=Europe/Berlin

# --- Automation Tuning ---
HEADLESS_BROWSER=true
REQUEST_TIMEOUT=25
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
