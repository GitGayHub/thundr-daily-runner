<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Выбор аккаунта"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSyncGithub"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#1E293B"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🔄 GitHub"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#151D30"
        android:hint="Поиск по аккаунтам..."
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvTotalStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Всего: 50 акк. | 64 мин | 8245 монет"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/lvAccounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#23304D"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="#1E293B"
        android:text="Закрыть"
        android:textColor="@color/text_white"
        android:textStyle="bold" />

</LinearLayout>
