<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:orientation="vertical">

    <!-- Top Navigation Toolbar -->
    <LinearLayout
        android:id="@+id/browserTopBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#161B22"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btnBackToAccounts"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_secondary"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBrowserAccountTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="👤 gamasek13 (3 мин | 385 🪙)"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReloadPage"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_secondary"
            android:text="🔄"
            android:textColor="@color/text_white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/browserProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressDrawable="@drawable/btn_primary"
        android:visibility="gone" />

    <!-- Main Fullscreen WebView with WebRTC Support -->
    <WebView
        android:id="@+id/browserWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0E17" />

</LinearLayout>
